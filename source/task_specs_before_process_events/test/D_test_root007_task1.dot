digraph MONA_DFA {
 rankdir = LR;
 center = true;
 size = "7.5,10.5";
 edge [fontname = Courier];
 node [height = .5, width = .5];
 node [shape = doublecircle]; 4;
 node [shape = circle]; 1;
 init [shape = plaintext, label = ""];
 init -> 1;
 1 -> 2 [label="red_moved | ~led_on"];
 1 -> 1 [label="led_on & ~pink_drawer & ~red_moved"];
 1 -> 3 [label="led_on & pink_drawer & ~red_moved"];
 2 -> 2 [label="true"];
 3 -> 2 [label="red_moved | ~led_on"];
 3 -> 3 [label="led_on & ~light_off & ~red_moved"];
 3 -> 4 [label="led_on & light_off & ~red_moved"];
 4 -> 2 [label="red_moved | ~led_on"];
 4 -> 4 [label="led_on & ~red_moved"];
}