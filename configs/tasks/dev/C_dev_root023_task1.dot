digraph MONA_DFA {
 rankdir = LR;
 center = true;
 size = "7.5,10.5";
 edge [fontname = Courier];
 node [height = .5, width = .5];
 node [shape = doublecircle]; 4;
 node [shape = circle]; 1;
 init [shape = plaintext, label = ""];
 init -> 1;
 1 -> 2 [label="led_was_off | ~led_on"];
 1 -> 1 [label="led_on & ~led_was_off & (~drawer_closed | ~red_drawer)"];
 1 -> 3 [label="drawer_closed & led_on & red_drawer & ~led_was_off"];
 2 -> 2 [label="true"];
 3 -> 2 [label="led_was_off | ~led_on"];
 3 -> 3 [label="led_on & ~led_was_off & ~light_off"];
 3 -> 4 [label="led_on & light_off & ~led_was_off"];
 4 -> 2 [label="led_was_off | ~led_on"];
 4 -> 4 [label="led_on & ~led_was_off"];
}